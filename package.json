{
  "name": "drobdi-cockpit",
  "version": "1.0.0",
  "description": "Cockpit de sprint pour le systeme scrum personnel drobdi (plugin Obsidian).",
  "main": "main.js",
  "type": "module",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run test/unit",
    "test:functional": "vitest run test/functional",
    "test:e2e": "wdio run e2e/wdio.conf.mts",
    "prepare": "git config core.hooksPath .githooks || true"
  },
  "keywords": [],
  "author": "Aymerick",
  "license": "MIT",
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^20.11.0",
    "@vitest/coverage-v8": "^1.6.1",
    "@wdio/cli": "^9.30.1",
    "@wdio/globals": "^9.29.1",
    "@wdio/local-runner": "^9.30.1",
    "@wdio/mocha-framework": "^9.30.1",
    "builtin-modules": "^3.3.0",
    "esbuild": "^0.21.0",
    "jsdom": "^24.1.3",
    "mocha": "^11.8.0",
    "obsidian": "latest",
    "tslib": "^2.6.0",
    "typescript": "^5.4.0",
    "vitest": "^1.6.0",
    "wdio-obsidian-reporter": "^3.1.1",
    "wdio-obsidian-service": "^3.1.1",
    "webdriverio": "^9.30.1"
  },
  "allowScripts": {
    "esbuild@0.21.5": true
  }
}
